          "name": "Login admin (T02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login admin: 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().access_token;",
                  "pm.test('JWT recibido', () => pm.expect(t).to.be.a('string').and.not.empty);",
                  "pm.test('token_type Bearer', () => pm.expect(pm.response.json().token_type).to.eql('Bearer'));",
                  "pm.collectionVariables.set('admin_token', t);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
