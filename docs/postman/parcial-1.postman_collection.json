        {
          "name": "Analizar con JWT manipulado (T03)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const [h, p, s] = pm.collectionVariables.get('user_token').split('.');",
                  "const flipped = (s[0] === 'A' ? 'B' : 'A') + s.slice(1);",
                  "pm.collectionVariables.set('tampered_token', [h, p, flipped].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('firma inválida: 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tampered_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/steganography/analyze",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "steganography",
                "analyze"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "docs/demo-imagenes/referencia.png",
                  "contentType": "image/png"
                }
              ]
            }
          }
        },
        {
          "name": "Analizar imagen de referencia (T09)",
          "event": [
            {
              "listen": "test",
              "script": {
