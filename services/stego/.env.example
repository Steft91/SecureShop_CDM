# Variables no secretas del servicio stego (spec §19, §23.7).
# La contraseña de la BD (db_stego_app) y el hash del token del gateway NO van aquí:
# se leen desde /run/secrets y los genera deploy/gen_secrets.py.

STEGO_QUARANTINE_DIR=/data
ALLOWED_ORIGINS=https://localhost
UPLOAD_MAX_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
ANALYZE_PER_MIN=10
STEGO_CHI2_P=0.995
STEGO_RS_RATE=0.15
STEGO_ENTROPY_TRIGGER=off
STEGO_TIMEOUT_S=10
