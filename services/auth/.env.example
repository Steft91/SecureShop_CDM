# Variables no secretas de configuración del servicio auth (spec §19, §23)
# NOTA: Los secretos (claves criptográficas, contraseñas de BD) NO van aquí;
# se leen desde /run/secrets y los genera deploy/gen_secrets.py.

JWT_TTL_MIN=15
ALLOWED_ORIGINS=https://localhost
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MIN=15
LOGIN_DELAY_BASE=0.25
REGISTER_MAX_PER_HOUR=10
